# ============================================================
# Переменные окружения — ПРИМЕР.
# Скопируй в .env и подставь свои значения:
#     copy .env.example .env
# Файл .env НЕ коммитится (см. .gitignore).
# ============================================================

POSTGRES_USER=kryli
POSTGRES_PASSWORD=change_me
POSTGRES_DB=kryli
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Строка подключения для SQLAlchemy
DATABASE_URL=postgresql+psycopg2://kryli:change_me@127.0.0.1:5432/kryli

# ---- Telegram API (для etl/load_telegram.py) ----
TG_API_ID=your_api_id
TG_API_HASH=your_api_hash
TG_CHANNEL=@krylikryli
